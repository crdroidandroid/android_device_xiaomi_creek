<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <FrameLayout
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:background="@drawable/about_avatar_ring"
        android:padding="6dp">

        <ImageView
            android:id="@+id/about_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/about_avatar_clip"
            android:contentDescription="@string/about_avatar_description"
            android:importantForAccessibility="yes"
            android:padding="24dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_neko_paw" />
    </FrameLayout>

    <TextView
        android:id="@+id/about_header_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/about_forker_dev_title"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/about_header_role"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/about_forker_dev_summary"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <Button
        android:id="@+id/about_header_github"
        style="?android:attr/buttonBarButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:drawableStart="@drawable/ic_about_github"
        android:drawablePadding="8dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/about_github_profile_button"
        android:textColor="?attr/colorPrimary" />

</LinearLayout>
