<?xml version="1.0" encoding="utf-8"?>
<!-- Shared axis X (forward): outgoing screen slides toward the start while fading out -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <translate
        android:duration="350"
        android:fromXDelta="0"
        android:toXDelta="-8%"
        android:interpolator="@interpolator/neko_emphasized_accelerate" />
    <alpha
        android:duration="90"
        android:fromAlpha="1"
        android:toAlpha="0"
        android:interpolator="@android:interpolator/linear" />
</set>
