android_app {
    name: "XiaomiParts",
    certificate: "platform",
    init_rc: ["init/init.xiaomiparts.rc"],
    srcs: [
        "src/**/*.kt",
        "src/**/*.java",
    ],
    resource_dirs: [
        "res",
    ],
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "org.lineageos.settings.resources",
        "vendor.xiaomi.hardware.displayfeature-V1.0-java",
    ],

    required: [
        "privapp_whitelist_com.xiaomi.settings.xml",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_com.xiaomi.settings.xml",
    src: "permissions/privapp_whitelist_com.xiaomi.settings.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
