on post-fs-data
    mkdir /data/system/AZenithInt 0775 root system
    mkdir /data/system/AZenithInt/API 0775 root system
    mkdir /data/system/AZenithInt/gamelist 0775 root system
    restorecon_recursive /data/system/AZenithInt

service vendor.azenith-service /system_ext/bin/vendor.azenith-service
    class main
    user root
    group root system shell readproc sdcard_r sdcard_rw media_rw
    capabilities SYS_NICE KILL SYS_ADMIN NET_ADMIN
    disabled

on property:sys.boot_completed=1 && property:persist.sys.azenithIntg.state=1
    start vendor.azenith-service

on property:sys.boot_completed=1 && property:persist.sys.azenithIntg.state=0
    stop vendor.azenith-service
