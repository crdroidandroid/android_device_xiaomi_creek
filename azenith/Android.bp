cc_prebuilt_binary {
    name: "vendor.azenith-service",
    srcs: ["bin/vendor.azenith-service"],
    stem: "vendor.azenith-service",
    vendor: true,
    shared_libs: ["liblog"],
    init_rc: ["init.azenith.rc"],
    vintf_fragments: ["vendor.azenith.xml"],
}

aidl_interface {
    name: "vendor.azenith",
    srcs: ["vendor/azenith/IAZenithService.aidl"],
    unstable: true,
    vendor_available: true,
    backend: {
        java: {
            enabled: true,
        },
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: false,
        },
    },
}
