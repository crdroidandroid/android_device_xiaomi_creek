type azenith, domain;
type azenith_exec, exec_type, vendor_file_type, file_type;
type azenith_data_file, file_type, data_file_type;

init_daemon_domain(azenith)

binder_use(azenith)
binder_service(azenith)

allow azenith self:capability { sys_nice kill sys_admin net_admin };

# Traverse /data/vendor and manage /data/vendor/AZenithInt
allow azenith vendor_data_file:dir search;

allow azenith azenith_data_file:dir create_dir_perms;
allow azenith azenith_data_file:file { create_file_perms lock map };
allow azenith azenith_data_file:lnk_file create_file_perms;

allow azenith self:unix_stream_socket create_stream_socket_perms;

# Vendor shell/toolbox & sysfs/proc tuning
allow azenith vendor_shell_exec:file rx_file_perms;
allow azenith vendor_toolbox_exec:file rx_file_perms;

allow azenith sysfs_devices_system_cpu:dir r_dir_perms;
allow azenith sysfs_devices_system_cpu:file rw_file_perms;
allow azenith vendor_sysfs_kgsl:dir r_dir_perms;
allow azenith vendor_sysfs_kgsl:file rw_file_perms;
allow azenith sysfs_devfreq:dir r_dir_perms;
allow azenith sysfs_devfreq:file rw_file_perms;
allow azenith sysfs_thermal:dir r_dir_perms;
allow azenith sysfs_thermal:file rw_file_perms;

allow azenith proc:dir r_dir_perms;
allow azenith proc_stat:file r_file_perms;
allow azenith proc_meminfo:file r_file_perms;
allow azenith proc_cpuinfo:file r_file_perms;

# Read AZenith config properties
get_prop(azenith, azenith_prop)
