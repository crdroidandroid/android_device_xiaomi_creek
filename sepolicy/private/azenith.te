init_daemon_domain(azenith)

binder_use(azenith)
binder_service(azenith)
add_service(azenith, vendor_azenith_service)

# XiaomiParts (system_app) <-> AZenith
allow system_app vendor_azenith_service:service_manager find;
binder_call(system_app, azenith)

# AZenith <-> system_server (AMS, PMS, Power, Display, BatteryProperties)
allow azenith {
    activity_service
    batteryproperties_service
    display_service
    notification_service
    package_service
    power_service
    window_service
    mount_service
    thermal_service
    surfaceflinger_service
}:service_manager find;
binder_call(azenith, system_server)
binder_call(system_server, azenith)
binder_call(azenith, surfaceflinger)

allow azenith self:capability { sys_nice kill sys_admin net_admin };
allow azenith self:unix_stream_socket create_stream_socket_perms;

# /data/system/AZenithInt storage
allow azenith system_data_file:dir search;
allow azenith azenith_data_file:dir create_dir_perms;
allow azenith azenith_data_file:file { create_file_perms lock map };
allow azenith azenith_data_file:lnk_file create_file_perms;

# Embedded BinderResolver via app_process64 + /system/bin/am & shell helpers
allow azenith zygote_exec:file rx_file_perms;
allow azenith shell_exec:file rx_file_perms;
allow azenith toolbox_exec:file rx_file_perms;
allow azenith system_file:file rx_file_perms;
allow azenith apex_module_data_file:dir { getattr search };

# Properties read by daemon & ART runtime
get_prop(azenith, azenith_prop)
set_prop(azenith, azenith_prop)
get_prop(azenith, dalvik_config_prop)
get_prop(azenith, dalvik_runtime_prop)
dontaudit azenith default_prop:file { getattr map open read };

# Read foreground app /proc/<pid>/cmdline; silence background daemon /proc scan spam
r_dir_file(azenith, appdomain)
dontaudit azenith domain:dir { getattr search open read };
dontaudit azenith domain:file { getattr open read };

# Core proc & sysfs tuning (neverallow-safe for coredomain)
allow azenith proc:dir r_dir_perms;
allow azenith proc:file getattr;
dontaudit azenith proc:file { r_file_perms write };
allow azenith proc_stat:file r_file_perms;
allow azenith proc_meminfo:file r_file_perms;
allow azenith proc_cpuinfo:file r_file_perms;
allow azenith proc_drop_caches:file rw_file_perms;
dontaudit azenith proc_drop_caches:file setattr;

allow azenith sysfs:dir { open read search getattr };
allow azenith sysfs:file getattr;
dontaudit azenith sysfs:file { open read write setattr };
allow azenith sysfs_devices_system_cpu:dir r_dir_perms;
allow azenith sysfs_devices_system_cpu:file { rw_file_perms setattr };
allow azenith sysfs_thermal:dir r_dir_perms;
allow azenith sysfs_thermal:file { rw_file_perms setattr };
dontaudit azenith proc_panic:file { getattr open read write setattr };
dontaudit azenith property_socket:sock_file write;

# Device-mapper block devices (/sys/block/dm-*) scanned during I/O tuning
allow azenith sysfs_dm:dir r_dir_perms;
allow azenith sysfs_dm:file { rw_file_perms setattr };

# Skip APEX loop and ZRAM block devices during /sys/block/* scan
dontaudit azenith { sysfs_loop sysfs_zram }:dir { search open read getattr };
dontaudit azenith { sysfs_loop sysfs_zram }:file { getattr open read write setattr };

# UFS/virtual block parent directory (/sys/devices/.../block)
allow azenith sysfs_devices_block:dir r_dir_perms;
allow azenith sysfs_devices_block:file r_file_perms;
dontaudit azenith sysfs_devices_block:file { write setattr };

# Fstrim (mount_service), pid_max, and neverallow-safe trace/prop silencing
allow azenith proc_pid_max:file r_file_perms;
dontaudit azenith build_attestation_prop:file { getattr open read map };
dontaudit azenith { debugfs_tracing debugfs_tracing_debug }:dir { getattr open read search };
dontaudit azenith { debugfs_tracing debugfs_tracing_debug }:file { getattr open read write setattr };

# ART dalvik-cache read, tmpfs/memfd, and TCP/perf/sched proc tuning
r_dir_file(azenith, dalvikcache_data_file)
allow azenith proc_net:dir r_dir_perms;
allow azenith proc_net:file rw_file_perms;
dontaudit azenith proc_net:file setattr;
allow azenith proc_perf:file rw_file_perms;
dontaudit azenith proc_perf:file setattr;
allow azenith proc_sched:file rw_file_perms;
dontaudit azenith proc_sched:file setattr;
allow azenith tmpfs:file rw_file_perms;
allow azenith proc_page_cluster:file rw_file_perms;
dontaudit azenith proc_page_cluster:file setattr;

# ART runtime helpers, TCP/perf/sched/VM proc tuning, and neverallow-safe silencing
r_dir_file(azenith, apex_art_data_file)
dontaudit azenith apex_art_data_file:file execute;
get_prop(azenith, odsign_prop)
dontaudit azenith tmpfs:file execute;
dontaudit azenith self:anon_inode { create getattr ioctl read write };
dontaudit azenith vdc_exec:file { getattr open read execute execute_no_trans };

# AZenith runtime data access
allow azenith azenith_data_file:dir { create search read write open getattr setattr add_name remove_name };
allow azenith azenith_data_file:file { create read write open getattr setattr unlink };
