# Dolby permissions for system_app (LunarisDolby) and platform_app
allow system_app hal_dms_hwservice:hwservice_manager find;
binder_call(system_app, hal_dms_default)
get_prop(system_app, vendor_audio_prop)

allow platform_app hal_dms_hwservice:hwservice_manager find;
binder_call(platform_app, hal_dms_default)
get_prop(platform_app, vendor_audio_prop)
