# Xiaomi MiSys AIDL service used by MIUI Camera
type vendor_misys_service, service_manager_type;

# MiSys HAL publishes the AIDL service
allow hal_misys_default vendor_misys_service:service_manager add;

# MIUI Camera accesses the AIDL service
allow platform_app_all vendor_misys_service:service_manager find;
binder_call(platform_app_all, hal_misys_default)
